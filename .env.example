# Copiar a .env.local para desarrollo (gitignored via *.local) y configurar
# como variable de entorno en Vercel para producción/preview.

# Base URL de la API de estancia-360-app (backend nuevo, code/estancia-360-app), SIN slash final.
# Local: apunta al backend corriendo con `npm run start:dev` (puerto 3001, prefijo /api).
VITE_API_BASE_URL=http://127.0.0.1:3001/api
