# Copiar a .env.local para desarrollo (gitignored via *.local) y configurar
# como variable de entorno en Vercel para producción/preview.

# Base URL de la API de estancia-360-app, SIN slash final.
# Local: apunta al backend corriendo con `npm run start:dev` (puerto 3000, prefijo /api/estancia-360).
VITE_API_BASE_URL=http://localhost:3000/api/estancia-360
